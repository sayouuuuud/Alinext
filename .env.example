# ============================================================================
# ALI FLEET — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` (or configure the same names in your Vercel
# project) and fill in real values. Everything below is OPTIONAL right now —
# the app runs on a file-backed content store until Supabase is activated.
# ============================================================================

# --- Supabase (activate later) ---------------------------------------------
# Found in your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only privileged key — NEVER expose to the browser. Used by the admin
# content API to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase auth redirect (already provisioned in this project) -----------
# Used for local auth redirects once Supabase Auth is enabled.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000"
