# ============================================================================
# ALI FLEET — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` (or configure the same names in your Vercel
# project) and fill in real values. Everything below is OPTIONAL right now —
# the app runs on a file-backed content store until Supabase is activated.
# ============================================================================

# --- Supabase (activate later) ---------------------------------------------
# Found in your Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only privileged key — NEVER expose to the browser. Used by the admin
# content API to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase auth redirect (already provisioned in this project) -----------
# Used for local auth redirects once Supabase Auth is enabled.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL="http://localhost:3000"

# --- Gmail SMTP for order notification emails (server-only) -----------------
# Create a Google App Password (Google account → 2-Step Verification → App
# passwords) and put it here. Email sending stays disabled until both
# SMTP_USER and SMTP_APP_PASSWORD are set; the outbox simply stays pending.
SMTP_USER="you@gmail.com"
SMTP_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# Optional overrides:
# SMTP_FROM_EMAIL="you@gmail.com"
# SMTP_FROM_NAME="ALI FLEET"

# --- Outbox cron (optional, server-only) ------------------------------------
# When set, GET /api/cron/notifications must send
# `Authorization: Bearer <CRON_SECRET>`. When empty, the endpoint is disabled.
CRON_SECRET=""

# --- Public site URL (used for links inside emails) -------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Local server media storage (optional) ----------------------------------
# Uploaded product/car images are stored on this server's disk instead of
# Supabase Storage. Defaults to <project>/public/uploads (served statically).
# Point it elsewhere (e.g. a mounted volume) if you prefer:
# LOCAL_UPLOAD_DIR="/var/data/alifleet-uploads"
